<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.thunderdex.service</string>
  <key>ProgramArguments</key><array><string>@PYTHON@</string><string>@ROOT@/service/server.py</string></array>
  <key>WorkingDirectory</key><string>@ROOT@/service/workspace</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardErrorPath</key><string>@HOME@/.local/state/thunderdex/service.log</string>
</dict></plist>
